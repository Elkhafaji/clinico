# Copy this file to .env in the repository root for local setup (PowerShell: Copy-Item .env.example .env).
# Replace the sample ADMIN_EMAIL and ADMIN_PASSWORD before running npm run dev; placeholder admin credentials are rejected.
# Never commit a real .env. The repository-root .env is loaded before backend/.env.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
PUBLIC_APP_ORIGIN=http://localhost:4000
TZ=Africa/Cairo

# Local development defaults to SQLite. Docker Compose overrides these values for MySQL 8.4.
# For Neon/Vercel, set DB_CLIENT=pg and DATABASE_URL to Neon’s pooled connection string (host includes -pooler).
DB_CLIENT=better-sqlite3
DB_FILENAME=./data/clinico.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=clinico
DB_PASSWORD=change-this-database-password
DB_NAME=clinico
DATABASE_URL=
MYSQL_ROOT_PASSWORD=change-this-mysql-root-password
# Local only; file storage is automatically disabled in Vercel unless a persistent store is integrated.
FILE_STORAGE_ENABLED=true

# Generate unique production secrets: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-unique-random-secret-of-at-least-32-characters
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups

# First admin is provisioned once by the seed command. It must change its password on first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-initial-password
ADMIN_NAME=Clinic Admin
ADMIN_FORCE_PASSWORD_CHANGE=true

# Sample users and data are optional and should stay disabled in production.
SEED_DEMO=false
DEMO_PASSWORD=replace-with-a-strong-demo-password

FEATURE_AI_PLAN=false
AI_PROVIDER=
AI_API_KEY=
FEATURE_VOICE_NOTES=false
TRANSCRIPTION_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
